    <bpmn:sequenceFlow id="F4" name="Não" sourceRef="g1" targetRef="t3"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F5" sourceRef="t3" targetRef="e1"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F6" sourceRef="e1" targetRef="t2"></bpmn:sequenceFlow>
