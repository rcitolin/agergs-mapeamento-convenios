  <bpmn:collaboration id="Colab_CONV">
    <bpmn:participant id="Part_CONV" name="CONV — Celebração de convênio ou contrato de delegação da regulação (AS-IS) (AS-IS · 18 casos · indicativo, com ressalva)" processRef="Processo_CONV" />
  </bpmn:collaboration>
  <bpmn:process id="Processo_CONV" isExecutable="false">
    <bpmn:documentation>Do pedido do município para delegar a regulação à AGERGS até a assinatura, publicação, comunicação ao prestador e arquivamento do processo Fontes: Consolidado das fichas e narrativas dos 12 processos de celebração (2018–2026) e do processo orientativo SEI 002594-39.00/26-9; variações observadas viram decisões com laço.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_CONV">
      <bpmn:lane id="Lane_PSE" name="Procuradoria Setorial da PGE (PSE)">
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
      </bpmn:lane>
